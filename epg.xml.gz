    <country lang="de">USA</country>
  </programme>
  
<programme start="20261014080000 +0200" stop="20261014085000 +0200" channel="CRIME.+.INVESTIGATION.at">
    <title lang="de">Interview mit einem Mörder</title>
    <sub-title lang="de">Cindy White</sub-title>
    <desc lang="de">Sarah "Cindy" White ist die am längsten inhaftierte Insassin im Frauengefängnis von Indiana. Vor 50 Jahren legte sie Feuer in dem Haus der Familie, bei der sie als Kindermädchen lebte. White war die einzige Person, die dem Blutbad entkommen konnte. Obwohl sie hinsichtlich der Ereignisse jener schicksalhaften Nacht lange Zeit als unzuverlässige Zeugin galt, hat White Reue für ihre Tat gezeigt und ist zu einer Symbolfigur für Befürworter einer Justizreform geworden, die argumentieren, dass ihre Haftstrafe lang genug gewesen sei.</desc>
    <credits>
      <director>Ethan Nelson</director>
    </credits>
    <category lang="de">Crime</category>
    <category lang="de">Dokumentationsreihe</category>
