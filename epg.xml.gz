    <country lang="de">GB</country>
  </programme>
  
<programme start="20261021080000 +0200" stop="20261021085000 +0200" channel="CRIME.+.INVESTIGATION.at">
    <title lang="de">Interview mit einem Mörder</title>
    <sub-title lang="de">Gary Hilton Teil 2</sub-title>
    <desc lang="de">Der berüchtigte Serienmörder Gary Michael Hilton spricht erstmals offen über seine Verbrechen. Hilton begann im Alter von 61 Jahren, Wanderer in National Forests in North Carolina, Georgia und Florida zu überfallen. In diesem Special enthüllt Hilton die dunklen Tatsachen, die zu seiner Mordserie führten, und gewährt dem Journalisten David Scott zum ersten Mal einen Einblick in seine verwirrte Psyche.</desc>
