<programme start="20261101033000 +0100" stop="20261101041000 +0100" channel="CRIME.+.INVESTIGATION.at">
    <title lang="de">Secrets of Penthouse - Sex, Macht, Ausbeutung</title>
    <sub-title lang="de">Der Visionär</sub-title>
    <desc lang="de">Die erste Folge beschäftigt sich mit dem außergewöhnlichen Aufstieg von Bob Guccione, der durch die Gründung des "Penthouse" Magazins zu einem der reichsten Männer Amerikas wurde, dabei aber seine Familie zerstörte.</desc>
    <credits>
      <director>Marc Williamson</director>
    </credits>
    <category lang="de">Crime</category>
    <category lang="de">Dokumentationsreihe</category>
