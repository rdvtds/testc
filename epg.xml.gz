    <country lang="de">USA</country>
  </programme>
  
<programme start="20261121210500 +0100" stop="20261121215500 +0100" channel="CRIME.+.INVESTIGATION.at">
    <title lang="de">Houses of Horror: Gewalt und Terror am College</title>
    <sub-title lang="de">Im Visier der Drogenfahnder</sub-title>
    <desc lang="de">Inmitten einer Reihe von schockierenden Überdosis-Todesfällen an der San Diego State University im Jahr 2007 startete die Drogenfahndung eine verdeckte Operation. Dabei wurden ein Theta-Chi-Bruder, der zum Kokain-König wurde, und die mit Drogen handelnde Mitglieder der Studentenverbindungen ins Visier genommen.</desc>
    <category lang="de">Crime</category>
    <category lang="de">Dokumentationsreihe</category>
