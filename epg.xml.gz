    <country lang="de">USA</country>
  </programme>
  
<programme start="20261105032500 +0100" stop="20261105041000 +0100" channel="CRIME.+.INVESTIGATION.at">
    <title lang="de">Witness to Murder - Digitale Zeugen</title>
    <sub-title lang="de">Digitale Obsession</sub-title>
    <desc lang="de">Ermittler, die herausfinden wollen, wer eine junge Mutter in Ohio erschossen hat, erhalten einen überraschenden Hinweis durch ein digitales Beweisstück. Dadurch kommen sie einer verdrehten Geschichte von Stalking und Catfishing auf die Spur.</desc>
    <credits>
      <director>Marcie Hume</director>
    </credits>
    <category lang="de">Crime</category>
    <category lang="de">Dokumentationsreihe</category>
