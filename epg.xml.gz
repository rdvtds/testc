    <country lang="de">IRL</country>
    <country lang="de">GB</country>
    <country lang="de">USA</country>
  </programme>
  
<programme start="20261115080000 +0100" stop="20261115083000 +0100" channel="CRIME.+.INVESTIGATION.at">
    <title lang="de">Unentdeckt - Mörder unter uns</title>
    <sub-title lang="de">Mord im Sturm</sub-title>
    <desc lang="de">Stephanie Bruner war Mutter und Tanzlehrerin, die damit kämpfte, ihre Ehe zusammenzuhalten. Nach einem Streit mit ihrem Mann geriet sie in einen Schneesturm in Colorado und verschwand. Die Stadtbewohner durchsuchten drei Tage lang die Wildnis und fanden ihre Leiche schließlich im Fluss - misshandelt und ertränkt. Als aus der Suche eine Morduntersuchung wird, entdeckt die Polizei die E-Mail-Spuren einer turbulenten Affäre, die schon lange vor Stephanies Ermordung von Eifersucht und Gewalt geschürt wurde. Es scheint, dass Stephanie Leidenschaften im und außerhalb des Tanzstudios entfacht hat.</desc>
    <credits>
      <director>Cameron Patterson</director>
      <director>Chris Soule</director>
    </credits>
    <category lang="de">Crime</category>
    <category lang="de">Serie</category>
    <icon src="https://files.fairu.app/b322771d-f16f-5507-9c84-390c945b14f7/unentdeckt-morder-unter-unsjpg.jpg" />
    <country lang="de">USA</country>
  </programme>
  
