    <country lang="de">USA</country>
  </programme>
  
<programme start="20261013051000 +0200" stop="20261013055500 +0200" channel="CRIME.+.INVESTIGATION.at">
    <title lang="de">Cold Case Files - Dead West</title>
    <sub-title lang="de">Mord in Salt Lake City</sub-title>
    <desc lang="de">Als die beliebte Matriarchin Sherry Black, 64, in ihrem Antiquariat in Salt Lake City ermordet wird, vermuten die Ermittler einen Diebstahl als Motiv. Der Fall bleibt ungeklärt, bis sich ihre Tochter mit einem gerissenen Ermittler zusammentut, um Sherrys Mörder vor Gericht zu bringen.</desc>
    <credits>
