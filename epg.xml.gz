<programme channel="647f8d22a2fc3fadb4721685-5efe1de7e0b3f5003f5d9f8e" start="20261031142054 +0000" stop="20261031160052 +0000">
    <title>The Temptations</title>
    <desc>The true story behind the legendary Motown musical sensation is brought to life in this touching miniseries.</desc>
