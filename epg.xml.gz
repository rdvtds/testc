<programme channel="DocuBox.HD.fr" start="20261001060000 +0000" stop="20261001062500 +0000">
    <title lang="fr">Travel Thru History</title>
    <sub-title lang="fr">Philadelphia</sub-title>
    <desc lang="fr">The city of brotherly love does not disappoint history lovers. We visit Independence hall, the liberty bell, Elfreth's alley, the Philadelphia Museum of Art, and get creeped out at America's first penitentiary, Eastern State.</desc>
    <category lang="fr">Documentaire de société</category>
    <icon src="http://static-cdn.tv.sfr.net/data/img/pl/2/7/4/15270472.jpg" />
    <episode-num system="onscreen">S1 E8</episode-num>
  </programme>
  
<programme channel="DocuBox.HD.fr" start="20261001062500 +0000" stop="20261001065000 +0000">
    <title lang="fr">Travel Thru History</title>
    <sub-title lang="fr">Nashville</sub-title>
    <desc lang="fr">This country music Mecca has a plethora of American history to explore. We'll stand on the stage of the Grand Ole Opry, visit the home of the 7th US President Andrew Jackson, and visit the largest recreation of the Parthenon outside of Greece.</desc>
    <category lang="fr">Documentaire de société</category>
    <icon src="http://static-cdn.tv.sfr.net/data/img/pl/2/7/4/15270472.jpg" />
    <episode-num system="onscreen">S1 E9</episode-num>
  </programme>
  
