    <country lang="de">USA</country>
  </programme>
  
<programme start="20260929175000 +0200" stop="20260929183500 +0200" channel="CRIME.+.INVESTIGATION.at">
    <title lang="de">Frauen im Todestrakt</title>
    <sub-title lang="de">Emilia Carr</sub-title>
    <desc lang="de">2009 wurden Emilia Carr und ihr Freund Joshua Fulgham wegen Mordes und Entführung von Heather Strong verurteilt, wobei nur Emilia zum Tode verurteilt wurde. Emilia spricht über ihre Erfahrungen während der Ermittlungen zu dem Mord und über ihre Erfahrungen im Todestrakt. Emilia beteuert weiterhin ihre Unschuld.</desc>
