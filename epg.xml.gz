    <country lang="de">IRL</country>
    <country lang="de">GB</country>
    <country lang="de">USA</country>
  </programme>
  
<programme start="20261012080000 +0200" stop="20261012085000 +0200" channel="CRIME.+.INVESTIGATION.at">
    <title lang="de">Interview mit einem Mörder</title>
    <sub-title lang="de">Bo Pete Jeffrey</sub-title>
    <desc lang="de">Bo Pete Jeffrey behauptet, keine Erinnerung an das Verbrechen zu haben, für das er verurteilt wurde: die brutale Misshandlung und Ermordung seiner Frau. Doch nun, vier Jahre nach Beginn seiner lebenslangen Haftstrafe, erzählt Jeffrey uns eine andere Geschichte, die einen neuen Einblick in die Psyche dieses verurteilten Mörders gewährt.</desc>
    <credits>
      <director>Ethan Nelson</director>
    </credits>
