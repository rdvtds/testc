<programme channel="647f8d22a2fc3fadb4721685-5efe1de7e0b3f5003f5d9f8e" start="20261002113632 +0000" stop="20261002131847 +0000">
    <title>Stylebender</title>
    <desc>Get your Romantic movie fix with Gravitas Movies - "Always in the Season of Love!</desc>
  </programme>
  
<programme channel="647f8d22a2fc3fadb4721685-5efe1de7e0b3f5003f5d9f8e" start="20261002131847 +0000" stop="20261002145807 +0000">
    <title>Fittest on Earth: Final Showdown in Madtown</title>
