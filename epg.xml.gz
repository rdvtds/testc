    <country lang="de">USA</country>
  </programme>
  
<programme start="20261017041500 +0200" stop="20261017050000 +0200" channel="CRIME.+.INVESTIGATION.at">
    <title lang="de">Cold Case Files</title>
    <sub-title lang="de">Roter Schnee</sub-title>
    <desc lang="de">Als der 19-jährige Chris Green 2002 in einem verschneiten Graben in Bangor, Michigan, erschlagen aufgefunden wird, befürchtet seine Familie, dass der Mord an ihrem Sohn nie aufgeklärt werden wird. Jahre vergehen, bis schockierende Enthüllungen eines Informanten auftauchen und den Fall gänzlich auf den Kopf stellen.</desc>
    <credits>
      <director>Varios</director>
      <actor>Ray Barry</actor>
