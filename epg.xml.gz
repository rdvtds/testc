    <country lang="de">GB</country>
  </programme>
  
<programme start="20261005103000 +0200" stop="20261005112000 +0200" channel="CRIME.+.INVESTIGATION.at">
    <title lang="de">Im Verhörraum</title>
    <sub-title lang="de">Schüsse in der Nacht</sub-title>
