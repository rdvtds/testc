    <country lang="de">USA</country>
  </programme>
  
<programme start="20261022174000 +0200" stop="20261022183000 +0200" channel="CRIME.+.INVESTIGATION.at">
    <title lang="de">Court Cam - Auf der Anklagebank</title>
    <sub-title lang="de">Cristhian Bahena Rivera</sub-title>
    <desc lang="de">Als die Studentin Mollie Tibbetts beim abendlichen Joggen verschwindet, durchkämmen die Ermittler ihre kleine Heimatstadt auf der Suche nach ihr. Und als ihr mutmaßlicher Angreifer, Cristhian Bahena Rivera, in den Zeugenstand tritt, wird die Geschichte komplizierter, als sie es sich je hätten vorstellen können. Wem werden die Geschworenen glauben?</desc>
    <category lang="de">Crime</category>
