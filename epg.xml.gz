    <country lang="de">USA</country>
  </programme>
  
<programme start="20261003062000 +0200" stop="20261003071000 +0200" channel="CRIME.+.INVESTIGATION.at">
    <title lang="de">Im Verhörraum</title>
    <sub-title lang="de">Mord in Myrtle Beach</sub-title>
    <desc lang="de">Nachdem ein erfolgreicher Geschäftsmann brutal erdrosselt wurde, schöpfen die Ermittler Verdacht gegen seine Witwe und ihren geheimnisvollen Freund.</desc>
    <credits>
      <actor>Ned Nolen</actor>
