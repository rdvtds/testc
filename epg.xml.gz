    <country lang="de">IRL</country>
    <country lang="de">GB</country>
    <country lang="de">USA</country>
  </programme>
  
<programme start="20261116233500 +0100" stop="20261117002500 +0100" channel="CRIME.+.INVESTIGATION.at">
    <title lang="de">Bloodline Detectives - Die DNA der Täter</title>
    <sub-title lang="de">Letzte Wanderung</sub-title>
    <desc lang="de">13. Juni 1987. Nachdem die College-Studentin Cathy Sposito auf dem Thumb Butte Trail in der Nähe der Innenstadt von Prescott, Arizona, brutal ermordet wurde, beginnt eine Morduntersuchung, die Jahrzehnte dauern wird. Mehr als 30 Jahre später, im Jahr 2022, können die Ermittler dem Fall neues Leben einhauchen und mithilfe der Investigativen Genetischen Genealogie endlich einen Verdächtigen für den Mord an der jungen Studentin finden.</desc>
    <credits>
      <director>Emile Dinneen</director>
      <director>Derek Dillon</director>
      <actor>Piers Gibbon</actor>
    </credits>
