    <country lang="de">CDN</country>
    <country lang="de">USA</country>
  </programme>
  
<programme start="20261121234500 +0100" stop="20261122001500 +0100" channel="CRIME.+.INVESTIGATION.at">
    <title lang="de">Der letzte Klick - Tödliche Online-Begegnungen</title>
    <sub-title lang="de">Cody</sub-title>
    <desc lang="de">Cody Virgin arbeitete in einem Gefängnis in Arizona. Er hatte eine gute Beziehung zu seiner Freundin. Für ihn lief es gut. Bis eine Frau namens Paige Woods auf Facebook anbot, sich mit Cody allein tief in der Wüste zu treffen. Cody schluckte den Köder, und wurde ermordet.</desc>
    <credits>
      <director>Lucas D. Miller</director>
      <actor>Eldridge Amstrong</actor>
